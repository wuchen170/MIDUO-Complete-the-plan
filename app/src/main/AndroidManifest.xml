<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 手势提示线的应用规则选择器需要枚举本机应用。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.xiaomi.smarthome" />
        <package android:name="com.autonavi.minimap" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="org.lsposed.manager" />
    </queries>

    <application
        android:name=".SoftGlassApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:theme="@style/AppTheme">
        <!-- 模块主入口：桌面 / 底栏 / 相机 / 壁纸 的统一设置页（Miuix 风格，带液态玻璃标签栏）。
             LSPosed 里点齿轮进这里。
             注意：这里**不能**带 LAUNCHER，否则桌面图标会绕过下面的 alias 一直显示，
             「显示桌面图标」开关就失效了（1.1.0/1.1.1 的 bug）。 -->
        <activity
            android:name=".fold.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 底栏的细项页（原 Compose 界面：逐个应用的图标、底栏、tab 开关）。
             从「底栏」标签页底部的按钮进入，不再单独作为模块入口。 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- 原 FOLD 的桌面图标别名，默认关闭；开关就在上面那个设置页里 -->
        <activity-alias
            android:name=".fold.Launcher"
            android:targetActivity=".fold.SettingsActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 控制中心磁贴：桌面 / 相机 / 壁纸这套功能的总开关 -->
        <service
            android:name=".fold.GlassTile"
            android:exported="true"
            android:icon="@drawable/ic_hg_tile"
            android:label="柔光玻璃"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- 第二个磁贴：直接打开桌面 / 相机 / 壁纸设置页 -->
        <service
            android:name=".fold.GlassSettingsTile"
            android:exported="true"
            android:icon="@drawable/ic_hg_tile"
            android:label="18duo 设置"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
